{\colortbl;\red255\green255\blue255;}
{\*\expandedcolortbl;;}
\margl1440\margr1440\vieww11520\viewh8400\viewkind0
\pard\tx566\tx1133\tx1700\tx2267\tx2834\tx3401\tx3968\tx4535\tx5102\tx5669\tx6236\tx6803\pardirnatural\partightenfactor0

\f0\fs24 \cf0 #cloud-config\
\
package_update: true\
package_upgrade: true\
\
packages:\
  - build-essential\
  - curl\
  - git\
  - python3\
  - python3-pip\
  - python3-venv\
  - docker.io\
  - docker-compose\
  - nvidia-driver-525\
  - nvidia-container-toolkit\
  - postgresql\
  - mariadb-server\
  - mongodb-org\
  - apache2\
  - prometheus\
  - grafana\
  - openjdk-11-jdk\
  - nodejs\
  - npm\
  - net-tools\
  - nginx\
  - traefik\
  - redis-server\
  - qemu-kvm\
  - libvirt-daemon-system\
  - libvirt-clients\
  - bridge-utils\
  - virt-manager\
  - ufw\
  - nfs-common\
  - 1password-cli\
\
write_files:\
  # Define all initialization scripts\
  - path: /root/init_databases.sh\
    permissions: '0755'\
    content: |\
      #!/bin/bash\
      echo "Initializing PostgreSQL"\
      sudo -u postgres psql -c "CREATE DATABASE lucidigital; CREATE USER lucia_admin WITH PASSWORD 'securepassword'; GRANT ALL PRIVILEGES ON DATABASE lucidigital TO lucia_admin;"\
      \
      echo "Initializing MongoDB"\
      systemctl start mongodb\
      echo 'use lucidigital; db.createUser(\{user:"lucia_admin", pwd:"securepassword", roles:[\{role:"readWrite", db:"lucidigital"\}]\});' | mongo\
\
      echo "Initializing MariaDB"\
      mysql -e "CREATE DATABASE lucidigital; CREATE USER 'lucia_admin'@'localhost' IDENTIFIED BY 'securepassword'; GRANT ALL PRIVILEGES ON lucidigital.* TO 'lucia_admin'@'localhost'; FLUSH PRIVILEGES;"\
\
  - path: /root/init_smart_boxes.sh\
    permissions: '0755'\
    content: |\
      #!/bin/bash\
      echo "Initializing Smart Box Test Environments"\
      for vm in smart_box mini_smart_box web3_smart_box hedera_testnet_vm; do\
        virt-install --name $vm --ram 4096 --vcpus 2 --disk size=20 --os-variant ubuntu20.04 --network network=default --graphics none --console pty,target_type=serial --location 'http://archive.ubuntu.com/ubuntu/dists/focal/main/installer-amd64/' --extra-args 'console=ttyS0,115200n8 serial'\
      done\
\
runcmd:\
  - echo "Updating and Installing Core Dependencies"\
  - apt-get update && apt-get upgrade -y\
\
  - echo "Configuring NVIDIA Drivers and Container Toolkit"\
  - distribution=$(. /etc/os-release;echo $ID$VERSION_ID)\
  - curl -s -L https://nvidia.github.io/nvidia-docker/gpgkey | sudo apt-key add -\
  - curl -s -L https://nvidia.github.io/nvidia-docker/$distribution/nvidia-docker.list | tee /etc/apt/sources.list.d/nvidia-docker.list\
  - apt-get update && apt-get install -y nvidia-container-toolkit nvidia-container-runtime\
\
  - echo "Running Database Initialization Scripts"\
  - bash /root/init_databases.sh\
\
  - echo "Configuring Netplan for Networking"\
  - |\
    cat <<EOF > /etc/netplan/01-netcfg.yaml\
    network:\
      version: 2\
      ethernets:\
        eth0:\
          dhcp4: false\
          addresses: [192.168.1.100/24]\
          gateway4: 192.168.1.1\
          nameservers:\
            addresses: [8.8.8.8]\
    EOF\
  - netplan apply\
\
  - echo "Setting up AI/ML Environment"\
  - pip3 install --upgrade pip\
  - pip3 install torch torchvision spacy nltk transformers sentence-transformers redis\
  - python3 -m spacy download en_core_web_sm\
  - pip3 install nvidia-pyindex nvidia-tensorflow tensorboard nvidia-dali\
  - pip3 install 1password-cli\
\
  - echo "Deploying Docker Containers for ManageEngine ServiceDesk Plus MSP, Prometheus, and Grafana"\
  - docker-compose -f /opt/nebula/docker-compose.yml up -d\
\
  - echo "Configuring Firewall"\
  - ufw allow ssh\
  - ufw allow http\
  - ufw allow https\
  - ufw allow 3000/tcp\
  - ufw allow 9090/tcp\
  - ufw enable\
\
  - echo "Running Smart Box Initialization Scripts"\
  - bash /root/init_smart_boxes.sh\
\
  - echo "Deploying Lucia-AI Services"\
  - docker-compose -f /opt/lucia/docker-compose.yml up -d\
\
  - echo "Final System Checks and Logging"\
  - systemctl start docker\
  - systemctl enable docker\
  - docker ps\
  - nvidia-smi\
\
final_message: "Luci Digital NEBULA_MasterX setup complete with all necessary components!"}