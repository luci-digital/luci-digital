\f0\fs24 \cf0 #cloud-config\
package_update: true\
package_upgrade: true\
\
packages:\
  - build-essential\
  - curl\
  - git\
  - python3\
  - python3-pip\
  - python3-venv\
  - docker.io\
  - docker-compose\
  - nvidia-driver-525\
  - nvidia-container-toolkit\
  - netplan.io\
  - postgresql\
  - mariadb-server\
  - mongodb-org\
  - apache2\
  - prometheus\
  - grafana\
  - openjdk-11-jdk\
  - nodejs\
  - npm\
  - net-tools\
  - nginx\
  - qemu-kvm\
