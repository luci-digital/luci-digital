  - libvirt-clients\
  - bridge-utils\
  - virt-manager\
  - ufw\
  - traefik\
  - three.js\
  - web3.js\
\
runcmd:\
  - echo "Updating packages and installing core dependencies"\
  - apt-get update && apt-get upgrade -y\
\
  - echo "Configuring NVIDIA Drivers and Container Toolkit"\
  - distribution=$(. /etc/os-release;echo $ID$VERSION_ID)\
  - curl -s -L https://nvidia.github.io/nvidia-docker/gpgkey | sudo apt-key add -\
  - curl -s -L https://nvidia.github.io/nvidia-docker/$distribution/nvidia-docker.list | tee /etc/apt/sources.list.d/nvidia-docker.list\
  - apt-get update && apt-get install -y nvidia-container-toolkit nvidia-container-runtime\
\
  - echo "Initializing Databases"\
  - sudo -u postgres psql -c "CREATE DATABASE lucidigital; CREATE USER lucia_admin WITH PASSWORD 'securepassword'; GRANT ALL PRIVILEGES ON DATABASE lucidigital TO lucia_admin;"\
  - systemctl start mongodb\
  - echo 'use lucidigital; db.createUser(\{user:"lucia_admin", pwd:"securepassword", roles:[\{role:"readWrite", db:"lucidigital"\}]\});' | mongo\
  - mysql -e "CREATE DATABASE lucidigital; CREATE USER 'lucia_admin'@'localhost' IDENTIFIED BY 'securepassword'; GRANT ALL PRIVILEGES ON lucidigital.* TO 'lucia_admin'@'localhost'; FLUSH PRIVILEGES;"\
\
  - echo "Configuring Netplan for Networking"\
  - |\
    cat <<EOF > /etc/netplan/01-netcfg.yaml\
    network:\
      version: 2\
      ethernets:\
        eth0:\
          dhcp4: false\
          addresses: [192.168.1.100/24]\
          gateway4: 192.168.1.1\
          nameservers:\
            addresses: [8.8.8.8]\
    EOF\
  - netplan apply\
\
  - echo "Setting up AI/ML environment"\
  - pip3 install --upgrade pip\
  - pip3 install torch torchvision spacy nltk transformers sentence-transformers\
  - python3 -m spacy download en_core_web_sm\
  - pip3 install nvidia-pyindex nvidia-tensorflow tensorboard nvidia-dali\
\
  - echo "Installing Hedera SDK for JavaScript"\
  - npm install --global yarn\
  - git clone https://github.com/hashgraph/hedera-sdk-js.git\
  - cd hedera-sdk-js\
  - yarn install\
  - yarn build\
  - echo "Setting up Prometheus and Grafana"\
  - docker run -d --name prometheus -p 9090:9090 -v /root/prometheus.yml:/etc/prometheus/prometheus.yml prom/prometheus\
  - docker run -d --name grafana -p 3000:3000 grafana/grafana\
\
  - echo "Initializing Smart Box Test Environments"\
  - for vm in smart_box mini_smart_box web3_smart_box hedera_testnet_vm; do\
      virt-install --name $vm --ram 4096 --vcpus 2 --disk size=20 --os-variant ubuntu20.04 --network network=default --graphics none --console pty,target_type=serial --location 'http://archive.ubuntu.com/ubuntu/dists/focal/main/installer-amd64/' --extra-args 'console=ttyS0,115200n8 serial'\
    done\
\
  - echo "Installing Spatial.io and Unity SDK"\
  - git clone https://github.com/spatialsys/spatial-unity-sdk.git /opt/spatial-unity-sdk\
  - cd /opt/spatial-unity-sdk\
  - ./install.sh\
  - apt-get install -y unityhub\
\
  - echo "Installing NFT and Web3 Libraries"\
  - npm install --global web3\
  - npm install --global ethers\
  - git clone https://github.com/OpenZeppelin/openzeppelin-contracts.git /opt/openzeppelin-contracts\
  - cd /opt/openzeppelin-contracts\
  - npm install\
\
  - echo "Setting up Lucia-AI Services"\
  - docker-compose -f /opt/nebula/docker-compose.yml up -d\
\
  - echo "Configuring 1Password CLI"\
  - curl -sS https://downloads.1password.com/linux/keys/1password.asc | gpg --dearmor --output /usr/share/keyrings/1password-archive-keyring.gpg\
  - echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/$(dpkg --print-architecture) stable main" | tee /etc/apt/sources.list.d/1password.list\
  - mkdir -p /etc/debsig/policies/AC2D62742012EA22/\
  - curl -sS https://downloads.1password.com/linux/debian/debsig/1password.pol | tee /etc/debsig/policies/AC2D62742012EA22/1password.pol\
  - mkdir -p /usr/share/debsig/keyrings/AC2D62742012EA22\
  - curl -sS https://downloads.1password.com/linux/keys/1password.asc | gpg --dearmor --output /usr/share/debsig/keyrings/AC2D62742012EA22/debsig.gpg\
  - apt update && apt install -y 1password-cli\
\
  - echo "Configuring firewall"\
  - ufw allow ssh\
  - ufw allow http\
  - ufw allow https\
  - ufw allow 3000/tcp\
  - ufw allow 9090/tcp\
  - ufw enable\
\
  - echo "Final system checks"\
  - systemctl start docker\
  - systemctl enable docker\
  - docker ps\
  - nvidia-smi\
\
