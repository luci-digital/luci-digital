\f0\fs24 \cf0 #cloud-config\
runcmd:\
  # Update and install necessary database packages\
  - apt-get update && apt-get upgrade -y\
  - apt-get install -y mongodb mariadb-server postgresql redis\
\
  # Enable and start database services\
  - systemctl enable mongodb mariadb postgresql redis\
  - systemctl start mongodb mariadb postgresql redis\
\
  # MongoDB Initialization for RAG, ML, AI & Sentiment Logging\
  - echo "Creating optimized MongoDB initialization script in /root/init_mongodb.js"\
  - |\
    cat <<EOF > /root/init_mongodb.js\
    use admin;\
    db.createUser(\{\
      user: "admin",\
      pwd: "securepassword",\
      roles: [ \{ role: "userAdminAnyDatabase", db: "admin" \} ]\
    \});\
\
    use lucidigital;\
    db.createCollection("users", \{ capped: false \});\
    db.createCollection("projects", \{ capped: false \});\
\
    // Collections for AI, ML, and RAG data storage\
    db.createCollection("model_parameters", \{ capped: false \});\
    db.createCollection("training_data", \{ capped: false \});\
    db.createCollection("inference_logs", \{ capped: false \});\
    \
    // Sentiment logging based on customer interactions\
    db.createCollection("sentiment_logs", \{ capped: false \});\
\
    db.sentiment_logs.createIndex(\{ sentiment_score: 1 \});\
    db.training_data.createIndex(\{ vector_embeddings: "2dsphere" \});\
    db.inference_logs.createIndex(\{ request_time: -1 \});\
    EOF\
\
  # MariaDB Initialization optimized for AI, ML & Sentiment Tracking\
  - echo "Creating optimized MariaDB initialization script in /root/init_mariadb.sql"\
  - |\
    cat <<EOF > /root/init_mariadb.sql\
    CREATE DATABASE IF NOT EXISTS lucidigital;\
    USE lucidigital;\
\
    -- Users table for AI interaction tracking\
    CREATE TABLE IF NOT EXISTS users (\
      id INT AUTO_INCREMENT PRIMARY KEY,\
      username VARCHAR(50) NOT NULL,\
      email VARCHAR(100) NOT NULL\
    );\
\
    -- Projects table for project data linked with Lucia-AI\
    CREATE TABLE IF NOT EXISTS projects (\
      id INT AUTO_INCREMENT PRIMARY KEY,\
      name VARCHAR(100) NOT NULL,\
      description TEXT,\
      model_data JSON\
    );\
\
    -- Sentiment Analysis Logs\
    CREATE TABLE IF NOT EXISTS sentiment_logs (\
      id INT AUTO_INCREMENT PRIMARY KEY,\
      user_id INT NOT NULL,\
      sentiment_score FLOAT,\
      sentiment_label VARCHAR(20),\
      timestamp DATETIME DEFAULT CURRENT_TIMESTAMP,\
      FOREIGN KEY (user_id) REFERENCES users(id)\
    );\
\
    -- Performance optimizations: Add Indexes\
    CREATE INDEX sentiment_index ON sentiment_logs(sentiment_score);\
    CREATE INDEX user_email_index ON users(email);\
    EOF\
\
  # PostgreSQL Initialization optimized for AI, ML, and Sentiment Logging\
  - echo "Creating optimized PostgreSQL initialization script in /root/init_postgresql.sql"\
  - |\
    cat <<EOF > /root/init_postgresql.sql\
    CREATE DATABASE lucidigital;\
    \\c lucidigital;\
\
    -- Users Table\
    CREATE TABLE users (\
      id SERIAL PRIMARY KEY,\
      username VARCHAR(50) NOT NULL,\
      email VARCHAR(100) NOT NULL\
    );\
\
    -- Projects Table\
    CREATE TABLE projects (\
      id SERIAL PRIMARY KEY,\
      name VARCHAR(100) NOT NULL,\
      description TEXT,\
      model_data JSONB\
    );\
\
    -- Sentiment Analysis Logs with AI tracking\
    CREATE TABLE sentiment_logs (\
      id SERIAL PRIMARY KEY,\
      user_id INT NOT NULL,\
      sentiment_score FLOAT,\
      sentiment_label VARCHAR(20),\
      timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\
      FOREIGN KEY (user_id) REFERENCES users(id)\
    );\
\
    -- Performance optimizations\
    CREATE INDEX sentiment_index ON sentiment_logs(sentiment_score);\
    CREATE INDEX user_email_index ON users(email);\
    EOF\
\
  # Execute database initialization scripts\
  - echo "Executing MongoDB initialization script"\
  - mongod --fork --logpath /var/log/mongodb.log\
  - mongo admin /root/init_mongodb.js\
\
  - echo "Executing MariaDB initialization script"\
  - mysql -u root < /root/init_mariadb.sql\
\
  - echo "Executing PostgreSQL initialization script"\
  - sudo -u postgres psql -f /root/init_postgresql.sql}