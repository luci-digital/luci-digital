\f0\fs24 \cf0 #!/bin/bash\
\
# Set variables for network configuration\
INTERFACE="eth0"  # Replace with the correct network interface name for your VM\
STATIC_IP="192.168.1.100"  # Replace with the desired static IP address\
GATEWAY="192.168.1.1"  # Replace with the correct gateway for your network\
DNS_SERVER="8.8.8.8"  # Replace with your preferred DNS server (e.g., Google DNS)\
\
# Check if the network interface exists\
if ! ip link show "$INTERFACE" > /dev/null 2>&1; then\
    echo "Network interface $INTERFACE does not exist. Exiting..."\
    exit 1\
fi\
\
# Configure the network interface with a static IP\
echo "Configuring network interface $INTERFACE with static IP $STATIC_IP"\
cat <<EOF > /etc/netplan/01-netcfg.yaml\
network:\
  version: 2\
  renderer: networkd\
  ethernets:\
    $INTERFACE:\
      addresses: [$STATIC_IP/24]\
      gateway4: $GATEWAY\
      nameservers:\
        addresses:\
          - $DNS_SERVER\
EOF\
\
# Apply the network configuration\
echo "Applying network configuration..."\
netplan apply\
\
# Verify the new configuration\
echo "Verifying the network setup..."\
ip addr show dev $INTERFACE\
ip route show\
\
# Test DNS resolution\
echo "Testing DNS resolution with ping to google.com..."\
ping -c 3 google.com\
\
# Additional firewall rules (if needed)\
# Uncomment the following lines to configure simple firewall rules\
\
# Install ufw (Uncomplicated Firewall)\
# apt-get install ufw -y\
\
# Allow SSH\
# ufw allow ssh\
\
# Enable UFW\
# ufw enable\
\
echo "Network configuration complete!"}