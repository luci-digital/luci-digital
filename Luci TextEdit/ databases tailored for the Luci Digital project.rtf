\f0\fs24 \cf0 #cloud-config\
package_update: true\
package_upgrade: true\
\
packages:\
  - mongodb\
  - mariadb-server\
  - postgresql\
  - influxdb\
  - rabbitmq-server\
  - python3-pip\
  - libpq-dev\
  - build-essential\
  - neo4j\
  - redis-server\
  - elasticsearch\
\
runcmd:\
  # General setup\
  - echo "Setting up database and AI infrastructure..."\
\
  # Initialize MongoDB\
  - echo "Creating MongoDB initialization script in root directory"\
  - |\
    cat <<EOF > /root/init_mongodb.js\
    use admin;\
    db.createUser(\{\
      user: "admin",\
      pwd: "securepassword",\
      roles: [ \{ role: "userAdminAnyDatabase", db: "admin" \} ]\
    \});\
    use lucidigital;\
    db.createCollection("users");\
    db.createCollection("projects");\
    db.createCollection("sentiment_analysis");\
    db.createCollection("event_logs");\
    db.createCollection("tokens");\
    db.sentiment_analysis.createIndex(\{ sentiment_score: 1 \});\
    db.event_logs.createIndex(\{ timestamp: 1 \});\
    EOF\
\
  # Initialize MariaDB\
  - echo "Creating MariaDB initialization script in root directory"\
  - |\
    cat <<EOF > /root/init_mariadb.sql\
    CREATE DATABASE IF NOT EXISTS lucidigital;\
    USE lucidigital;\
    CREATE TABLE IF NOT EXISTS users (\
      id INT AUTO_INCREMENT PRIMARY KEY,\
      username VARCHAR(50) NOT NULL,\
      email VARCHAR(100) NOT NULL\
    );\
    CREATE TABLE IF NOT EXISTS projects (\
      id INT AUTO_INCREMENT PRIMARY KEY,\
      name VARCHAR(100) NOT NULL,\
      description TEXT\
    );\
    CREATE TABLE IF NOT EXISTS tokens (\
      id INT AUTO_INCREMENT PRIMARY KEY,\
      token_id VARCHAR(100),\
      user_id INT,\
      timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP\
    );\
    CREATE TABLE IF NOT EXISTS sentiment_analysis (\
      id INT AUTO_INCREMENT PRIMARY KEY,\
      user_id INT,\
      sentiment_score FLOAT,\
      sentiment_label VARCHAR(100),\
      timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP\
    );\
    CREATE INDEX sentiment_idx ON sentiment_analysis(sentiment_score);\
    EOF\
\
  # Initialize PostgreSQL\
  - echo "Creating PostgreSQL initialization script in root directory"\
  - |\
    cat <<EOF > /root/init_postgresql.sql\
    CREATE DATABASE lucidigital;\
    \\c lucidigital;\
    CREATE TABLE users (\
      id SERIAL PRIMARY KEY,\
      username VARCHAR(50) NOT NULL,\
      email VARCHAR(100) NOT NULL\
    );\
    CREATE TABLE projects (\
      id SERIAL PRIMARY KEY,\
      name VARCHAR(100) NOT NULL,\
      description TEXT\
    );\
    CREATE TABLE tokens (\
      id SERIAL PRIMARY KEY,\
      token_id VARCHAR(100),\
      user_id INT,\
      timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP\
    );\
    CREATE TABLE sentiment_analysis (\
      id SERIAL PRIMARY KEY,\
      user_id INT,\
      sentiment_score FLOAT,\
      sentiment_label VARCHAR(100),\
      timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP\
    );\
    CREATE INDEX sentiment_idx ON sentiment_analysis(sentiment_score);\
    EOF\
\
  # Time-Series DB - InfluxDB Setup\
  - echo "Setting up InfluxDB for IoT and Time-Series data"\
  - systemctl start influxdb\
  - |\
    cat <<EOF > /root/init_influxdb.sql\
    CREATE DATABASE iot_data;\
    CREATE RETENTION POLICY "30days" ON iot_data DURATION 30d REPLICATION 1 DEFAULT;\
    EOF\
  - influx -execute "CREATE DATABASE iot_data"\
  - influx -execute "CREATE RETENTION POLICY \\"30days\\" ON iot_data DURATION 30d REPLICATION 1 DEFAULT"\
\
  # RabbitMQ for Event-Driven Architecture\
  - echo "Starting RabbitMQ"\
  - systemctl enable rabbitmq-server\
  - systemctl start rabbitmq-server\
\
  # Neo4j for Graph Data\
  - echo "Starting Neo4j Graph Database for relationship tracking"\
  - systemctl start neo4j\
  - |\
    cat <<EOF > /root/init_neo4j.cql\
    CREATE CONSTRAINT ON (u:User) ASSERT u.username IS UNIQUE;\
    CREATE CONSTRAINT ON (p:Project) ASSERT p.name IS UNIQUE;\
    CREATE CONSTRAINT ON (t:Token) ASSERT t.token_id IS UNIQUE;\
    EOF\
  - neo4j-shell -file /root/init_neo4j.cql\
\
  # Elasticsearch for NLP and Search Optimization\
  - echo "Setting up Elasticsearch for full-text search"\
  - systemctl enable elasticsearch\
  - systemctl start elasticsearch\
\
  # Finalizing Database Initialization\
  - echo "Executing database initialization scripts"\
  - mongod --fork --logpath /var/log/mongodb.log\
  - mongo admin /root/init_mongodb.js\
  - mysql -u root < /root/init_mariadb.sql\
  - sudo -u postgres psql -f /root/init_postgresql.sql\
  - neo4j-shell -file /root/init_neo4j.cql\
\
final_message: "Luci Digital cloud-init setup is complete, including databases optimized for AI, ML, RAG, and IoT."}