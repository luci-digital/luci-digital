\f0\b\fs30 \cf2 Enhanced Cloud-Init Script for Proxmox and Luci Digital Setup\
\
\
#cloud-config\
\
hostname: nebula-master\
fqdn: nebula.lucidigital.io\
\
package_update: true\
package_upgrade: true\
\
packages:\
  - python3-pip\
  - docker.io\
  - docker-compose\
  - certbot\
  - qrencode\
  - nginx\
  - nodejs\
  - npm\
  - curl\
  - prometheus\
  - python3-certbot-nginx\
  - git\
  - build-essential\
  - nvidia-driver-525\
  - nvidia-container-toolkit\
  - mongodb-org\
  - postgresql\
  - mariadb-server\
  - openjdk-11-jdk\
  - ufw\
  - traefik\
  - qemu-kvm\
  - libvirt-daemon-system\
  - libvirt-clients\
  - bridge-utils\
  - virt-manager\
  - filecoin\
  - pve-qemu-kvm\
  - proxmox-backup-client\
  - nvidia-container-runtime\
\
users:\
  - name: lucidigital_admin\
    sudo: ['ALL=(ALL) NOPASSWD:ALL']\
    groups: sudo, docker\
    home: /home/lucidigital_admin\
    shell: /bin/bash\
    lock_passwd: false\
    ssh-authorized-keys:\
      - ssh-rsa AAA...your_ssh_public_key_here\
\
write_files:\
  - path: /opt/luci-digital/scripts/generate_qr.sh\
    permissions: '0755'\
    content: |\
      #!/bin/bash\
      qrencode -o /var/www/html/qr_code.png "$1"\
\
  - path: /opt/luci-digital/scripts/webhook_handler.js\
    permissions: '0755'\
    content: |\
      // Add your webhook handling logic here\
\
  - path: /opt/luci-digital/scripts/gpu_passthrough_setup.sh\
    permissions: '0755'\
    content: |\
      #!/bin/bash\
      echo "Configuring GPU passthrough"\
      modprobe vfio-pci\
      echo "options vfio-pci ids=10de:1b80,10de:10f0" > /etc/modprobe.d/vfio.conf\
      update-initramfs -u\
\
runcmd:\
  - echo "Starting Luci Digital setup process" | tee -a /var/log/luci-setup.log\
\
  # System updates and core dependency setup\
  - apt-get update && apt-get upgrade -y\
\
  # NVIDIA setup\
  - distribution=$(. /etc/os-release;echo $ID$VERSION_ID)\
  - curl -s -L https://nvidia.github.io/nvidia-docker/gpgkey | sudo apt-key add -\
  - curl -s -L https://nvidia.github.io/nvidia-docker/$distribution/nvidia-docker.list | tee /etc/apt/sources.list.d/nvidia-docker.list\
  - apt-get update && apt-get install -y nvidia-container-toolkit nvidia-container-runtime\
\
  # Docker setup\
  - systemctl enable docker\
  - systemctl start docker\
  - docker network create web\
\
  # Prometheus setup\
  - echo "Setting up Prometheus for network monitoring"\
  - docker run -d --name prometheus -p 9090:9090 -v /root/prometheus.yml:/etc/prometheus/prometheus.yml prom/prometheus\
\
  # Database setup\
  - systemctl start mongodb\
  - echo 'use lucidigital; db.createUser(\{user:"lucia_admin", pwd:"securepassword", roles:[\{role:"readWrite", db:"lucidigital"\}]\});' | mongo\
  - sudo -u postgres psql -c "CREATE DATABASE lucidigital; CREATE USER lucia_admin WITH PASSWORD 'securepassword'; GRANT ALL PRIVILEGES ON DATABASE lucidigital TO lucia_admin;"\
  - mysql -e "CREATE DATABASE lucidigital; CREATE USER 'lucia_admin'@'localhost' IDENTIFIED BY 'securepassword'; GRANT ALL PRIVILEGES ON lucidigital.* TO 'lucia_admin'@'localhost'; FLUSH PRIVILEGES;"\
\
  # AI/ML setup\
  - pip3 install torch torchvision spacy nltk transformers sentence-transformers\
  - python3 -m spacy download en_core_web_sm\
  - pip3 install nvidia-pyindex nvidia-tensorflow tensorboard\
\
  # Hedera SDK setup\
  - npm install --global yarn\
  - git clone https://github.com/hashgraph/hedera-sdk-js.git\
  - cd hedera-sdk-js && yarn install && yarn build\
\
  # ChatRTX and GPU setup\
  - wget https://github.com/NVIDIA/ChatRTX\
  - bash /opt/luci-digital/scripts/gpu_passthrough_setup.sh\
\
  # Traefik setup\
  - docker run -d --name traefik -p 80:80 -p 443:443 -v /var/run/docker.sock:/var/run/docker.sock traefik:v2.4\
\
  # Certbot setup\
  - certbot --nginx -d nebula.lucidigital.io -d monitoring.lucidigital.io\
\
  # QR Code Generation\
  - bash /opt/luci-digital/scripts/generate_qr.sh "http://10.0.0.170:8000/webhook"\
\
  # UFW firewall setup\
  - ufw allow 22/tcp\
  - ufw allow 80/tcp\
  - ufw allow 443/tcp\
  - ufw allow 9090/tcp\
  - ufw allow 3000/tcp\
  - ufw --force enable\
\
  # Final checks\
  - nvidia-smi\
  - docker ps\
  - systemctl status mongodb postgresql mariadb-server nginx\
\
  - echo "Luci Digital setup complete" | tee -a /var/log/luci-setup.log\
\
final_message: "Luci Digital NEBULA_MasterX setup complete with enhanced monitoring, AI/ML capabilities, IoT integration, QR code generation, and webhook handling!"}