\f0\fs28 \cf2 #cloud-config\
runcmd:\
  # Update packages\
  - apt-get update && apt-get upgrade -y\
  \
  # Install necessary database packages\
  - apt-get install -y mongodb mariadb-server postgresql\
\
  # Enable and start services\
  - systemctl enable mongodb mariadb postgresql\
  - systemctl start mongodb mariadb postgresql\
\
  # Create MongoDB initialization script\
  - echo "Creating MongoDB initialization script in /root/init_mongodb.js"\
  - |\
    cat <<EOF > /root/init_mongodb.js\
    use admin;\
    db.createUser(\{\
      user: "admin",\
      pwd: "securepassword",\
      roles: [ \{ role: "userAdminAnyDatabase", db: "admin" \} ]\
    \});\
    use lucidigital;\
    db.createCollection("users");\
    db.createCollection("projects");\
    EOF\
\
  # Create MariaDB initialization script\
  - echo "Creating MariaDB initialization script in /root/init_mariadb.sql"\
  - |\
    cat <<EOF > /root/init_mariadb.sql\
    CREATE DATABASE IF NOT EXISTS lucidigital;\
    USE lucidigital;\
    CREATE TABLE IF NOT EXISTS users (\
      id INT AUTO_INCREMENT PRIMARY KEY,\
      username VARCHAR(50) NOT NULL,\
      email VARCHAR(100) NOT NULL\
    );\
    CREATE TABLE IF NOT EXISTS projects (\
      id INT AUTO_INCREMENT PRIMARY KEY,\
      name VARCHAR(100) NOT NULL,\
      description TEXT\
    );\
    EOF\
\
  # Create PostgreSQL initialization script\
  - echo "Creating PostgreSQL initialization script in /root/init_postgresql.sql"\
  - |\
    cat <<EOF > /root/init_postgresql.sql\
    CREATE DATABASE lucidigital;\
    \\c lucidigital\
    CREATE TABLE users (\
      id SERIAL PRIMARY KEY,\
      username VARCHAR(50) NOT NULL,\
      email VARCHAR(100) NOT NULL\
    );\
    CREATE TABLE projects (\
      id SERIAL PRIMARY KEY,\
      name VARCHAR(100) NOT NULL,\
      description TEXT\
    );\
    EOF\
\
  # Run database initialization scripts\
  - echo "Executing MongoDB initialization script"\
  - mongod --fork --logpath /var/log/mongodb.log\
  - mongo admin /root/init_mongodb.js\
\
  - echo "Executing MariaDB initialization script"\
  - mysql -u root < /root/init_mariadb.sql\
\
  - echo "Executing PostgreSQL initialization script"\
  - sudo -u postgres psql -f /root/init_postgresql.sql}