ZOHO_SDK_VERSION="1.0.0"  # Update with the correct version if needed\
\
# Log file\
LOG_FILE="/var/log/lucidigital_setup.log"\
\
# Function to log messages\
log_message() \{\
    echo "$(date +'%Y-%m-%d %H:%M:%S') - $1" | tee -a $LOG_FILE\
\}\
\
# Exit on error\
set -e\
\
log_message "Starting Luci Digital setup process..."\
\
# System Update & Basic Installations\
log_message "Updating system packages..."\
apt-get update -y || \{ log_message "Failed to update system packages"; exit 1; \}\
apt-get upgrade -y || \{ log_message "Failed to upgrade system packages"; exit 1; \}\
\
# Install Docker, Docker Compose, UFW, and other dependencies\
log_message "Installing Docker, Docker Compose, and other dependencies..."\
apt-get install -y docker.io docker-compose curl git ufw python3-pip || \{ log_message "Failed to install Docker and dependencies"; exit 1; \}\
\
# Install Node.js and npm using package manager\
log_message "Installing Node.js and npm..."\
curl -sL https://deb.nodesource.com/setup_$NODE_VERSION | bash - || \{ log_message "Failed to set up Node.js repository"; exit 1; \}\
apt-get install -y nodejs || \{ log_message "Failed to install Node.js"; exit 1; \}\
\
# Install Zoho SDK via npm\
log_message "Installing Zoho SDK..."\
