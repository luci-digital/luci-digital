\f0\fs24 \cf0 #cloud-config\
hostname: marketing-lucidigital\
fqdn: marketing.lucidigital.io\
\
# Update package sources\
package_update: true\
package_upgrade: true\
\
# Users setup\
users:\
  - default\
  - name: marketing\
    sudo: ['ALL=(ALL) NOPASSWD:ALL']\
    groups: sudo, docker\
    home: /home/marketing\
    shell: /bin/bash\
    lock_passwd: false\
    ssh-authorized-keys:\
      - ssh-rsa AAA...your_ssh_public_key_here\
\
# Install necessary packages for marketing & engagement\
packages:\
  - docker.io\
  - docker-compose\
  - curl\
  - git\
  - ufw\
  - net-tools\
  - unzip\
  - python3-pip\
  - nodejs\
  - npm\
  - ffmpeg\
  - gimp\
  - blender\
  - obs-studio\
  - wordpress\
  - inkscape\
  - audacity\
  - openssh-server\
  - nginx\
  - certbot\
  - python3-certbot-nginx\
  - web3.js\
  - three.js\
  - ghost-cli\
\
# Install Ubuntu Studio tools for content creation\
runcmd:\
  - apt-get install -y ubuntustudio-installer\
  - ubuntustudio-installer -a\
\
# Set up Docker and run necessary services (WordPress, Ghost, etc.)\
runcmd:\
  - systemctl enable docker\
  - systemctl start docker\
  - docker network create web\
  - docker-compose up -d\
\
# Enable Firewall and Open Ports for Web Access\
firewall:\
  ufw:\
    ipv6: yes\
    rules:\
      - allow in on eth0 to any port 22 proto tcp\
      - allow in on eth0 to any port 80 proto tcp\
      - allow in on eth0 to any port 443 proto tcp\
      - allow in on eth0 to any port 9000 proto tcp\
\
# Set up Certbot for SSL certificates\
runcmd:\
  - certbot --nginx -d marketing.lucidigital.io\
\
# Install NodeJS-based marketing automation tools (e.g., Ghost)\
runcmd:\
  - npm install -g ghost-cli\
  - ghost install local\
\
# Set up WordPress as the content management platform\
runcmd:\
  - docker run --name wordpress -p 8080:80 -d wordpress\
\
# Set up and configure Nginx for website traffic handling\
runcmd:\
  - systemctl enable nginx\
  - systemctl start nginx\
\
# Install NFT and Web3 Libraries for NFT 2.0 integration\
runcmd:\
  - npm install --global web3\
  - npm install --global ethers\
  - git clone https://github.com/OpenZeppelin/openzeppelin-contracts.git /opt/openzeppelin-contracts\
  - cd /opt/openzeppelin-contracts\
  - npm install\
\
# Install Spatial.io SDK for metaverse integration\
runcmd:\
  - git clone https://github.com/spatialsys/spatial-unity-sdk.git /opt/spatial-unity-sdk\
  - cd /opt/spatial-unity-sdk\
  - ./install.sh\
  - apt-get install -y unityhub\
\
# Enable SSH for management and set up security rules\
runcmd:\
  - ufw --force enable\
  - apt-get clean\
  - history -c\
\
final_message: "Marketing VM provisioned and ready. Integrations with Spatial.io, NFTs, metaverse, and marketing automation completed."}