\f0\fs24 \cf0 #cloud-config\
package_update: true\
package_upgrade: true\
\
runcmd:\
  # Update and install necessary packages\
  - echo "Updating packages and installing core dependencies"\
  - |\
    apt-get update && apt-get install -y \\\
    build-essential \\\
    curl \\\
    git \\\
    python3 \\\
    python3-pip \\\
    docker.io \\\
    docker-compose \\\
    nvidia-driver-525 \\\
    nvidia-container-toolkit \\\
    netplan.io \\\
    postgresql \\\
    mariadb-server \\\
    mongodb-org \\\
    cloudstack-management-server \\\
    apache2 \\\
    prometheus \\\
    grafana\
\
  # Configure NVIDIA drivers and container toolkit\
  - echo "Configuring NVIDIA Drivers and Container Toolkit"\
  - |\
    distribution=$(. /etc/os-release;echo $ID$VERSION_ID)\
    curl -s -L https://nvidia.github.io/nvidia-docker/gpgkey | sudo apt-key add -\
    curl -s -L https://nvidia.github.io/nvidia-docker/$distribution/nvidia-docker.list | tee /etc/apt/sources.list.d/nvidia-docker.list\
    apt-get update && apt-get install -y nvidia-container-toolkit nvidia-container-runtime\
\
  # Initialize PostgreSQL Database\
  - echo "Initializing PostgreSQL Database"\
  - |\
    sudo -u postgres psql -c "CREATE DATABASE lucidigital;"\
    sudo -u postgres psql -c "CREATE USER lucia_admin WITH PASSWORD 'securepassword';"\
    sudo -u postgres psql -c "GRANT ALL PRIVILEGES ON DATABASE lucidigital TO lucia_admin;"\
\
  # Initialize MongoDB and MariaDB\
  - echo "Initializing MongoDB and MariaDB"\
  - |\
    sudo service mongodb start\
    echo 'use lucidigital; db.createUser(\{user:"lucia_admin", pwd:"securepassword", roles:[\{role:"readWrite", db:"lucidigital"\}]\});' | mongo\
    sudo mysql -e "CREATE DATABASE lucidigital; CREATE USER 'lucia_admin'@'localhost' IDENTIFIED BY 'securepassword'; GRANT ALL PRIVILEGES ON lucidigital.* TO 'lucia_admin'@'localhost'; FLUSH PRIVILEGES;"\
\
  # Initialize Netplan Configuration\
  - echo "Configuring Netplan for Networking"\
  - |\
    cat <<EOF > /etc/netplan/01-netcfg.yaml\
    network:\
      version: 2\
      ethernets:\
        ens160:\
          dhcp4: true\
EOF\
    netplan apply\
\
  # Configure NVIDIA system for AI/ML workloads\
  - echo "Setting up AI/ML environment with RAG and inference capabilities"\
  - |\
    pip3 install torch torchvision spacy nltk transformers sentence-transformers\
    python3 -m spacy download en_core_web_sm\
    pip3 install nvidia-pyindex\
    pip3 install nvidia-tensorflow\
    pip3 install tensorboard nvidia-dali\
\
  # Install Hedera SDK for Blockchain Testing\
  - echo "Installing Hedera SDK for Web3 interaction"\
  - |\
    curl -sSL https://get.sdkman.io | bash\
    source "$HOME/.sdkman/bin/sdkman-init.sh"\
    sdk install java 11.0.11.j9-adpt\
    sdk install hedera-sdk-java\
\
  # Prometheus and Grafana Setup\
  - echo "Setting up Prometheus and Grafana for Monitoring"\
  - |\
    docker run -d --name prometheus -p 9090:9090 -v /root/prometheus.yml:/etc/prometheus/prometheus.yml prom/prometheus\
    docker run -d --name grafana -p 3000:3000 grafana/grafana\
\
  # Initialize Smart Box VM Environments\
  - echo "Initializing Smart Box Test Environments"\
  - |\
    for vm in smart_box mini_smart_box web3_smart_box hedera_testnet_vm; do\
      cloudstack-management-server --create-vm $vm --cpu 2 --ram 4096 --storage 20G --os Ubuntu-20.04\
    done\
\
  # Initialize Lucia-AI Services\
  - echo "Initializing Lucia-AI Services"\
  - |\
    docker-compose -f /root/lucia_docker/docker-compose.yml up -d\
    systemctl enable lucia_ai\
\
  # Final cleanup and checks\
  - echo "Running final checks and cleanup"\
  - |\
    docker ps\
    systemctl status lucia_ai\
    nvidia-smi}