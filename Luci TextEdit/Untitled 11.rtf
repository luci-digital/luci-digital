\f0\fs24 \cf0 #!/bin/bash\
\
echo "Starting comprehensive dependency installation..."\
\
# Update system and install base utilities\
sudo apt-get update && sudo apt-get upgrade -y\
sudo apt-get install -y build-essential curl wget git net-tools gnupg2 software-properties-common apt-transport-https ca-certificates lsb-release\
\
# Docker installation for container management\
echo "Installing Docker..."\
sudo apt-get remove -y docker docker-engine docker.io containerd runc\
sudo apt-get update\
sudo apt-get install -y docker.io\
sudo systemctl start docker\
sudo systemctl enable docker\
\
# Docker Compose installation\
echo "Installing Docker Compose..."\
sudo curl -L "https://github.com/docker/compose/releases/download/2.10.2/docker-compose-$(uname -s)-$(uname -m)" -o /usr/local/bin/docker-compose\
sudo chmod +x /usr/local/bin/docker-compose\
\
# NVIDIA drivers for AI/ML\
echo "Installing NVIDIA drivers and container toolkit..."\
sudo apt-get install -y nvidia-driver-525 nvidia-container-toolkit\
sudo systemctl restart docker\
\
# Python environment and essential libraries\
echo "Installing Python and essential Python libraries..."\
sudo apt-get install -y python3 python3-pip python3-venv\
pip3 install --upgrade pip\
pip3 install numpy pandas matplotlib scipy scikit-learn jupyter torch torchvision tensorflow keras\
\
# Prometheus for monitoring\
echo "Installing Prometheus for monitoring..."\
sudo apt-get install -y prometheus\
sudo systemctl enable prometheus\
sudo systemctl start prometheus\
\
# Grafana for data visualization\
echo "Installing Grafana for monitoring and visualization..."\
sudo apt-get install -y grafana\
sudo systemctl enable grafana-server\
sudo systemctl start grafana-server\
\
# Database setup (PostgreSQL, MariaDB, MongoDB)\
echo "Installing databases: PostgreSQL, MariaDB, MongoDB..."\
sudo apt-get install -y postgresql mariadb-server mongodb-org\
sudo systemctl enable postgresql mariadb mongodb\
sudo systemctl start postgresql mariadb mongodb\
\
# Traefik for reverse proxy\
echo "Installing Traefik..."\
sudo apt-get install -y traefik\
\
# OpenJDK for Java-based tools\
echo "Installing OpenJDK..."\
sudo apt-get install -y openjdk-11-jdk\
\
# Certbot for SSL certificates\
echo "Installing Certbot for Let's Encrypt SSL management..."\
sudo apt-get install -y certbot python3-certbot-nginx\
\
# Virtualization (QEMU, KVM)\
echo "Installing virtualization tools (QEMU, KVM)..."\
sudo apt-get install -y qemu-kvm libvirt-daemon-system libvirt-clients bridge-utils virt-manager\
\
# Additional tools\
echo "Installing additional tools for file compression and editing..."\
sudo apt-get install -y ffmpeg blender gimp inkscape audacity\
\
# Enable firewall and open necessary ports\
echo "Configuring firewall..."\
sudo ufw allow OpenSSH\
sudo ufw allow 80/tcp\
sudo ufw allow 443/tcp\
sudo ufw allow 9090/tcp  # Prometheus\
sudo ufw allow 3000/tcp  # Grafana\
sudo ufw --force enable\
\
# Install Filecoin (Optional)\
echo "Installing Filecoin (Optional)..."\
sudo apt-get install -y filecoin\
\
# Final cleanup\
echo "Cleaning up..."\
sudo apt-get autoremove -y\
sudo apt-get clean\
\
echo "All necessary dependencies and tools have been installed."\
}