write_files:\
  - path: /root/init_compliance_db.sh\
    permissions: '0755'\
    content: |\
      #!/bin/bash\
      echo "Initializing PostgreSQL for Compliance"\
      sudo -u postgres psql -c "CREATE DATABASE compliance_db;"\
      sudo -u postgres psql -d compliance_db -c "CREATE TABLE standards (standard_id SERIAL PRIMARY KEY, standard_name VARCHAR(255), description TEXT, latest_version VARCHAR(50), compliance_status VARCHAR(50), effective_date DATE, review_date DATE);"\
      sudo -u postgres psql -d compliance_db -c "CREATE TABLE controls (control_id SERIAL PRIMARY KEY, standard_id INT REFERENCES standards(standard_id), control_name VARCHAR(255), description TEXT, status VARCHAR(50), audit_frequency VARCHAR(50), last_audit_date DATE, evidence_url TEXT);"\
      sudo -u postgres psql -d compliance_db -c "CREATE TABLE practices (practice_id SERIAL PRIMARY KEY, practice_name VARCHAR(255), description TEXT, standard_id INT REFERENCES standards(standard_id), responsible_party VARCHAR(255), monitoring_status VARCHAR(50));"\
      sudo -u postgres psql -d compliance_db -c "CREATE TABLE compliance_logs (log_id SERIAL PRIMARY KEY, practice_id INT REFERENCES practices(practice_id), log_date DATE, status VARCHAR(50), remarks TEXT, next_action TEXT);"\
      \
runcmd:\
  - echo "Executing database initialization scripts"\
  - bash /root/init_compliance_db.sh\
\
final_message: "Compliance database structure initialized successfully for ISO, IEC, and EU AI Act monitoring!"}